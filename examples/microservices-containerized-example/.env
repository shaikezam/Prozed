# Shared environment for the containerized task-tracker example.
# Prozed resolves ${VAR} / ${VAR:default} placeholders in each service's prozed.properties
# against these values (injected into every java service via `env_file` in docker-compose.yml).

# --- No inline default in prozed.properties: MUST be set here, else resolves to "" ---
DB_HOST=task-tracker-mariadb
DB_PASSWORD=root
MQ_HOST=task-tracker-activemq

# --- Has inline default in prozed.properties: overridden here to show precedence ---
DB_USER=root
MQ_USER=admin

# --- Intentionally omitted (has ${...:default} in prozed.properties, default is used) ---
# DB_PORT        -> defaults to 3306
# MQ_PORT        -> defaults to 61616
# MQ_PASSWORD    -> defaults to admin
# SERVICE_PORT   -> defaults to 8080
